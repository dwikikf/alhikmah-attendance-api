# ============================================================
# ALHIKMAH ATTENDANCE API - ENVIRONMENT CONFIGURATION
# Salin file ini menjadi .env dan sesuaikan nilainya.
# JANGAN commit file .env ke dalam repositori git!
# ============================================================

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DATABASE
DB_NAME=alhikmah_db

# --- Server ---
PORT=8080

# --- Aplikasi ---
# Nilai: development | production
APP_ENV=development

# URL frontend yang diizinkan mengakses API (CORS)
# Development : http://localhost:3000
# Production  : https://nama-aplikasi-anda.vercel.app
FRONTEND_URL=http://localhost:3000

# --- JWT Secrets ---
# WAJIB diganti dengan string acak yang panjang dan unik!
# Generate dengan perintah: openssl rand -base64 64
JWT_SECRET=GANTI_DENGAN_STRING_RAHASIA_PANJANG
JWT_REFRESH_SECRET=GANTI_DENGAN_STRING_RAHASIA_REFRESH_YANG_BERBEDA

# --- Durasi Token (Format Go duration: 1h, 30m, 15m, 168h) ---
# Development : nilai lebih longgar untuk kemudahan testing
# Production  : nilai lebih ketat untuk keamanan
#
# Access Token  - Development: 1h | Production: 15m
# Refresh Token - Development: 168h (7 hari) | Production: 168h (7 hari)
ACCESS_TOKEN_DURATION=1h
REFRESH_TOKEN_DURATION=168h
