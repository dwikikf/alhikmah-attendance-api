# ============================================================
# ALHIKMAH ATTENDANCE API - ENVIRONMENT CONFIGURATION (DEV)
# ============================================================

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secretpassword
DB_NAME=alhikmah_db

# --- Server ---
PORT=8080

# --- Aplikasi ---
# Nilai: dev | development | prod | production
APP_ENV=development

# URL frontend yang diizinkan mengakses API (CORS)
# Development: http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- JWT Secrets ---
# WAJIB diganti dengan string acak yang panjang dan unik di production!
# Contoh generate: openssl rand -base64 64
JWT_SECRET=supersecretjwttoken-ganti-di-production
JWT_REFRESH_SECRET=supersecretrefreshjwttoken-ganti-di-production

# --- Durasi Token ---
# Format Go duration: 1h, 30m, 15m, 7d (tidak valid - gunakan 168h), dsb.
# Development: lebih longgar untuk kemudahan testing
ACCESS_TOKEN_DURATION=1h
REFRESH_TOKEN_DURATION=168h
